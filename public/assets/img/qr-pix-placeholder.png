<?xml version="1.0" encoding="UTF-8"?>
<svg width="256" height="256" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="256" height="256" fill="#F5FBFE"/>
  <rect x="10" y="10" width="236" height="236" fill="white" stroke="#E0DEEF" stroke-width="2" rx="8"/>
  
  <!-- QR Code Pattern (simplified) -->
  <g fill="#231F20">
    <!-- Top-left corner -->
    <rect x="30" y="30" width="60" height="60" rx="4"/>
    <rect x="45" y="45" width="30" height="30" fill="#F5FBFE" rx="2"/>
    <rect x="55" y="55" width="10" height="10"/>
    
    <!-- Top-right corner -->
    <rect x="166" y="30" width="60" height="60" rx="4"/>
    <rect x="181" y="45" width="30" height="30" fill="#F5FBFE" rx="2"/>
    <rect x="191" y="55" width="10" height="10"/>
    
    <!-- Bottom-left corner -->
    <rect x="30" y="166" width="60" height="60" rx="4"/>
    <rect x="45" y="181" width="30" height="30" fill="#F5FBFE" rx="2"/>
    <rect x="55" y="191" width="10" height="10"/>
    
    <!-- Random dots pattern -->
    <rect x="110" y="40" width="10" height="10"/>
    <rect x="130" y="40" width="10" height="10"/>
    <rect x="110" y="60" width="10" height="10"/>
    <rect x="130" y="70" width="10" height="10"/>
    <rect x="150" y="50" width="10" height="10"/>
    
    <rect x="40" y="110" width="10" height="10"/>
    <rect x="60" y="110" width="10" height="10"/>
    <rect x="50" y="130" width="10" height="10"/>
    <rect x="70" y="140" width="10" height="10"/>
    
    <rect x="110" y="110" width="10" height="10"/>
    <rect x="130" y="110" width="10" height="10"/>
    <rect x="150" y="110" width="10" height="10"/>
    <rect x="120" y="130" width="10" height="10"/>
    <rect x="140" y="140" width="10" height="10"/>
    
    <rect x="170" y="110" width="10" height="10"/>
    <rect x="190" y="110" width="10" height="10"/>
    <rect x="180" y="130" width="10" height="10"/>
    <rect x="200" y="140" width="10" height="10"/>
    
    <rect x="110" y="170" width="10" height="10"/>
    <rect x="130" y="180" width="10" height="10"/>
    <rect x="150" y="170" width="10" height="10"/>
    <rect x="170" y="190" width="10" height="10"/>
    <rect x="190" y="200" width="10" height="10"/>
    <rect x="210" y="210" width="10" height="10"/>
  </g>
  
  <!-- Watermark EXEMPLO with semi-transparent background -->
  <rect x="78" y="108" width="100" height="40" fill="white" opacity="0.85" rx="4"/>
  <text x="128" y="133" font-family="Outfit, sans-serif" font-size="18" fill="#076A97" text-anchor="middle" font-weight="700" opacity="0.9">EXEMPLO</text>
</svg>
